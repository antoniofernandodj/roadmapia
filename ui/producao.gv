<!-- Tela 3 — a produção.
   O esboço vira uma fila de centenas de trechos, e um pool de workers os
   escreve em paralelo, um arquivo por trecho. A tela mostra o plano antes de
   começar (com a conta a pagar), o avanço durante, e o que ficou pelo
   caminho depois. -->
<screen>
  <resources>
    <script src="scripts/producao.luau"></script>
  </resources>

  <container class="tela">
    <column class="coluna cresce">

    <!-- ── cabeçalho ──────────────────────────────────────────────────── -->
    <row class="linha">
      <column class="dupla">
        <text class="titulo-obra" content="{obra_titulo}" />
        <text class="nota" content="{obra_subtitulo}" />
      </column>
      <button
        class="btn-sutil"
        text="← respostas"
        navigate_to="perguntas"
      />
      <button
        class="btn-sutil"
        text="início"
        navigate_to="inicio"
      />
    </row>

    <!-- ── sem plano ainda ────────────────────────────────────────────── -->
    <column class="painel-alto" if="{tem_obra}" not_equals="true">
      <text class="pergunta">Nada planejado ainda</text>
      <text class="ajuda">Responda a entrevista e clique em Generate.</text>
      <button class="btn-primario" text="Ir para as perguntas" navigate_to="perguntas" />
    </column>

    <!-- ── painel de avanço ───────────────────────────────────────────── -->
    <column class="painel" if="{tem_obra}" equals="true">
      <row class="linha">
        <text class="contador">{prontos} / {total_tarefas} trechos</text>
        <text class="nota">·  {n_capitulos} capítulos</text>
        <text class="nota" if="{tem_erros}" equals="true">·  {rotulo_erros}</text>
        <text class="largo" content="" />
        <text class="ok">{rotulo_custo}</text>
      </row>
      <progressbar class="progresso-verde" value="pct" min="0" max="100" />
      <row class="linha">
        <spinner class="spinner" hidden="{parado}" />
        <text class="corpo largo">{status}</text>
      </row>
    </column>

    <!-- ── os capítulos ───────────────────────────────────────────────── -->
    <scrollable
      class="largo cresce"
      direction="vertical"
      if="{tem_obra}"
      equals="true"
    >
    <column class="lista">
      <row class="faixa linha" for-each="capitulos_ui" var="c">
      <text class="contador num">{c.n}</text>
      <column class="dupla">
        <text class="corpo">{c.titulo}</text>
        <text class="nota">{c.detalhe}</text>
      </column>
      <text class="marca" color="{c.cor}">{c.marca}</text>
      </row>
    </column>
    </scrollable>

    <container class="faixa" if="{tem_erro}" equals="true">
      <text class="erro">{erro}</text>
    </container>

    <!-- ── ações ──────────────────────────────────────────────────────── -->
    <row class="painel linha" if="{tem_obra}" equals="true">
      <button
        class="btn-gerar"
        text="{rotulo_produzir}"
        on_click="produzir"
        hidden="{produzindo}"
        disabled="{nada_a_fazer}"
      />
      <button
        class="btn"
        text="Parar"
        on_click="parar"
        hidden="{parado}"
      />
      <button
        class="btn"
        text="Refazer falhas"
        on_click="refazer_falhas"
        hidden="{sem_falhas}"
        disabled="{produzindo}"
      />
      <button
        class="btn"
        text="Copiar caminho"
        on_click="clipboard:obra_pasta"
      />
      <button
        class="btn"
        text="Salvar obra"
        on_click="salvar_obra"
        if="{pode_salvar}"
        equals="true"
      />
      <text class="largo" content="" />
      <text class="nota">{obra_pasta}</text>
    </row>

    </column>
  </container>
</screen>
