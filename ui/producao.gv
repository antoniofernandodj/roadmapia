<!-- Tela 3 — a produção.
   O esboço vira uma fila de centenas de trechos, e um pool de workers os
   escreve em paralelo, um arquivo por trecho. A tela mostra o plano antes de
   começar (com a conta a pagar), o avanço durante, e o que ficou pelo
   caminho depois. -->

<container class="tela">
  <column class="coluna" width="fill" height="fill" spacing="14">

  <!-- ── cabeçalho ──────────────────────────────────────────────────── -->
  <row width="fill" spacing="12" alignY="Center">
    <column spacing="2" width="fill">
    <text class="titulo" size="22" content="{obra_titulo}" />
    <text class="nota" content="{obra_subtitulo}" />
    </column>
    <button
      class="btn-sutil"
      text="← respostas"
      navigateTo="perguntas"
    />
    <button
      class="btn-sutil"
      text="início"
      navigateTo="inicio"
    />
  </row>

  <!-- ── sem plano ainda ────────────────────────────────────────────── -->
  <column class="painel-alto" spacing="10" if="{tem_obra}" notEquals="true">
    <text class="pergunta" content="Nada planejado ainda" />
    <text class="ajuda" content="Responda a entrevista e clique em Generate." />
    <button class="btn-primario" text="Ir para as perguntas" navigateTo="perguntas" />
  </column>

  <!-- ── painel de avanço ───────────────────────────────────────────── -->
  <column class="painel" spacing="10" if="{tem_obra}" equals="true">
    <row width="fill" spacing="12" alignY="Center">
      <text
        class="contador"
        content="{prontos} / {total_tarefas} trechos"
      />
      <text
        class="nota"
        content="·  {n_capitulos} capítulos"
      />
      <text
        class="nota"
        content="·  {rotulo_erros}"
        if="{tem_erros}"
        equals="true"
      />
      <text
        content=""
        width="fill"
      />
      <text
        class="ok"
        content="{rotulo_custo}"
      />
    </row>
    <progressbar
      value="pct"
      min="0"
      max="100"
      width="fill"
      height="8"
      color="#A6E3A1"
      background="#313244"
      borderRadius="4"
    />
    <row width="fill" spacing="10" alignY="Center">
      <spinner width="16" height="16" color="#A6E3A1" hidden="{parado}" />
      <text class="corpo" content="{status}" width="fill" />
    </row>
  </column>

  <!-- ── os capítulos ───────────────────────────────────────────────── -->
  <scrollable
    direction="vertical"
    width="fill"
    height="fill"
    if="{tem_obra}"
    equals="true"
  >
  <column spacing="8" width="fill">
    <row class="faixa" for-each="capitulos_ui" var="c" spacing="12" alignY="Center">
    <text
      class="contador"
      content="{c.n}"
      width="28"
    />
    <column spacing="2" width="fill">
      <text class="corpo" content="{c.titulo}" />
      <text class="nota" content="{c.detalhe}" />
    </column>
    <text content="{c.marca}" size="13" color="{c.cor}" />
    </row>
  </column>
  </scrollable>

  <container class="faixa" if="{tem_erro}" equals="true">
    <text class="erro" content="{erro}" />
  </container>

  <!-- ── ações ──────────────────────────────────────────────────────── -->
  <row class="painel" spacing="12" alignY="Center" if="{tem_obra}" equals="true">
    <button
      class="btn-gerar"
      text="{rotulo_produzir}"
      on_click="produzir"
      hidden="{produzindo}"
      disabled="{nada_a_fazer}"
    />
    <button
      class="btn"
      text="Parar"
      on_click="parar"
      hidden="{parado}"
    />
    <button
      class="btn"
      text="Refazer falhas"
      on_click="refazer_falhas"
      hidden="{sem_falhas}"
      disabled="{produzindo}"
    />
    <button
      class="btn"
      text="Copiar caminho"
      on_click="clipboard:obra_pasta"
    />
    <text content="" width="fill" />
    <text class="nota" content="{obra_pasta}" />
  </row>

  </column>
</container>

<script src="producao.luau"></script>
