<!-- Tela 2 — a entrevista.
   Uma pergunta por vez. As opções vêm da IA e são chips clicáveis (multi-
   seleção); logo abaixo, um campo livre para quem quer escrever a própria
   resposta. As duas coisas convivem: dá para marcar duas opções E completar
   por escrito. -->

<container class="tela">
  <container width="fill" height="fill" alignX="Center">
    <column class="coluna" width="760" height="fill">

      <!-- ── cabeçalho: contexto + progresso ────────────────────────────── -->
      <row width="fill" spacing="12" alignY="Center">
        <column spacing="2" width="fill">
          <text class="rotulo" content="{tipo_rotulo} · {assunto}" />
          <text
            class="nota"
            content="Pergunta {q_num} de {total_perguntas} · {respondidas} respondida(s)"
          />
        </column>
        <button
          class="btn-sutil"
          text="← início"
          navigateTo="inicio"
        />
      </row>

      <progressbar
        value="progresso"
        min="0"
        max="100"
        width="fill"
        height="6"
        color="#89B4FA"
        background="#313244"
        borderRadius="3"
      />

      <!-- ── a pergunta ─────────────────────────────────────────────────── -->
      <column class="painel-alto" spacing="16" height="fill" if="{tem_perguntas}" equals="true">

        <column spacing="6" width="fill">
          <text class="pergunta" content="{q_texto}" />
          <text class="ajuda" content="{q_ajuda}" />
        </column>

        <scrollable direction="vertical" width="fill" height="fill">
        <column spacing="16" width="fill">

          <!-- Opções sugeridas pela IA. `cor` e o prefixo ✓/○ do rótulo são
            calculados no script — o estado de seleção mora nas respostas,
            não numa chave de contexto por opção. -->
          <column spacing="8" width="fill" if="{tem_opcoes}" equals="true">
            <text
              class="rotulo"
              content="SUGESTÕES — CLIQUE PARA MARCAR (PODE MAIS DE UMA)"
            />
            <button
              class="opcao"
              for-each="q_opcoes"
              var="o"
              text="{o.rotulo}" background="{o.cor}"
              on_click="alternar:{o.i}"
              width="fill"
            />
          </column>

          <!-- ...e/ou a resposta em texto livre. -->
          <column spacing="6" width="fill">
            <text class="rotulo" content="OU RESPONDA COM SUAS PALAVRAS" />
            <textarea
              class="campo"
              placeholder="opcional — complementa as opções marcadas"
              value="q_livre" onChange="livre_mudou" width="fill" height="110"
            />
          </column>

        </column>
        </scrollable>

        <!-- ── navegação entre perguntas ──────────────────────────────── -->
        <row width="fill" spacing="10" alignY="Center">
          <button
            class="btn"
            text="← anterior"
            on_click="anterior"
            disabled="{eh_primeira}"
          />
          <!-- Na última pergunta, "próxima" some (não há para onde ir) e dá
            lugar a "concluir →", que salta para o fim da fila. Sem isso,
            quem chegava ao fim ficava clicando em "próxima" sem efeito. -->
          <button
            class="btn-primario"
            text="próxima →"
            on_click="proxima"
            hidden="{eh_ultima}"
          />
          <button
            class="btn-primario"
            text="concluir →"
            on_click="concluir"
            hidden="{ja_no_fim}"
          />
          <button
            class="btn"
            text="+ aprofundar"
            on_click="aprofundar"
            disabled="{ocupado}"
          />
          <text content="" width="fill" />
          <spinner
            width="18"
            height="18"
            color="#A6E3A1"
            hidden="{parado}"
          />
          <text class="corpo" content="{status}" />
        </row>

      </column>

      <!-- Sem perguntas na memória (entrou direto nesta tela). -->
      <column class="painel-alto" spacing="10" if="{tem_perguntas}" notEquals="true">
        <text
          class="pergunta"
          content="Nenhuma entrevista em andamento"
        />
        <text
          class="ajuda"
          content="Volte ao início, diga o assunto e clique em Refinar."
        />
        <button
          class="btn-primario"
          text="Ir para o início"
          navigateTo="inicio"
        />
      </column>

      <container class="faixa" if="{tem_erro}" equals="true">
        <text class="erro" content="{erro}" />
      </container>

      <!-- ── gerar ──────────────────────────────────────────────────────── -->
      <row class="painel" spacing="14" alignY="Center" if="{tem_perguntas}" equals="true">
        <column spacing="2" width="fill">
          <text class="corpo" content="Pronto para gerar {tipo_artigo}?" />
          <text class="nota" content="{aviso_gerar}" />
        </column>
        <button
          class="btn-gerar"
          text="Generate"
          on_click="gerar"
          disabled="{ocupado}"
        />
      </row>

    </column>
  </container>
</container>

<script src="perguntas.luau"></script>
