<!-- Tela 1 — o pedido bruto.
   O botão principal NÃO submete nada: ele leva o assunto para a IA e volta
   com um questionário sob medida, que é o que a tela `perguntas` consome. -->

<container class="tela">
  <scrollable direction="vertical" width="fill" height="fill">
    <container width="fill" alignX="Center">
      <column class="coluna" width="720">

        <column spacing="4" width="fill">
          <text class="titulo" content="roadmapia" />
          <text
            class="subtitulo"
            content="Diga o assunto, responda algumas perguntas, receba o material."
          />
        </column>

        <!-- ── 1. o assunto ───────────────────────────────────────────────── -->
        <column class="painel-alto" spacing="10">
          <text class="rotulo" content="1 · SOBRE O QUE?" />
          <input
            class="campo"
            placeholder="ex.: Rust para quem já programa em Python, com foco em CLIs"
            value="assunto"
            onChange="assunto_mudou"
            width="fill"
          />
          <text
            class="ajuda"
            content="Quanto mais contexto aqui, mais afiadas as perguntas de refinamento."
          />
        </column>

        <!-- ── 2. o tipo de artefato ──────────────────────────────────────── -->
        <column class="painel" spacing="12">
          <text class="rotulo" content="2 · O QUE GERAR?" />
          <column spacing="10" width="fill">
            <checkbox
              label="Roadmap — trilha por fases, com marcos e dependências"
              checked="tipo_roadmap"
              onToggle="escolher_tipo:roadmap"
            />
            <checkbox
              label="Curso — módulos, aulas, exercícios e avaliação"
              checked="tipo_curso"
              onToggle="escolher_tipo:curso"
            />
            <checkbox
              label="Guia — referência prática, direto ao ponto"
              checked="tipo_guia"
              onToggle="escolher_tipo:guia"
            />
          </column>
        </column>

        <!-- ── 3. o modelo ────────────────────────────────────────────────── -->
        <column class="painel" spacing="12">
          <row width="fill" spacing="10" alignY="Center">
            <text class="rotulo" content="3 · MODELO E CHAVE" width="fill" />
            <button
              class="btn-sutil"
              text="{rotulo_avancado}"
              on_click="alternar_avancado"
            />
          </row>

          <column spacing="10" width="fill" if="{mostrar_avancado}">
            <column spacing="6" width="fill">
              <text class="ajuda" content="Modelo (OpenRouter)" />
              <select
                options="modelos"
                value="modelo"
                onChange="modelo_mudou"
                placeholder="escolha um modelo"
                width="fill"
                padding="10"
              />
            </column>

            <column spacing="6" width="fill">
              <text
                class="ajuda"
                content="Ou um id qualquer do catálogo do OpenRouter"
              />
              <input
                class="campo"
                placeholder="autor/modelo"
                value="modelo"
                onChange="modelo_mudou"
                width="fill"
              />
            </column>

            <column spacing="6" width="fill" if="{api_key_do_ambiente}" notEquals="true">
              <text
                class="ajuda"
                content="Chave da API (fica guardada localmente)"
              />
              <input
                class="campo"
                placeholder="sk-or-v1-..."
                value="api_key"
                onChange="chave_mudou"
                secure="true"
                width="fill"
              />
            </column>
            <text class="ok" content="Chave lida de OPENROUTER_API_KEY."
              if="{api_key_do_ambiente}" equals="true" />
          </column>

          <text
            class="nota"
            content="{resumo_config}"
            if="{mostrar_avancado}"
            notEquals="true"
          />
        </column>

        <!-- ── ação ───────────────────────────────────────────────────────── -->
        <row spacing="14" width="fill" alignY="Center">
          <button
            class="btn-primario"
            text="Refinar com perguntas →"
            on_click="refinar"
            disabled="{ocupado}"
          />
          <button
            class="btn"
            text="Retomar entrevista"
            navigateTo="perguntas"
            hidden="{sem_perguntas}"
          />
          <spinner
            width="20"
            height="20"
            color="#89B4FA"
            hidden="{parado}"
          />
          <text class="corpo" content="{status}" width="fill" />
        </row>

        <container class="faixa" if="{tem_erro}" equals="true">
          <text class="erro" content="{erro}" />
        </container>

      </column>
    </container>
  </scrollable>
</container>

<script src="inicio.luau"></script>
