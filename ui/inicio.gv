// Tela 1 — o pedido bruto.
// O botão principal NÃO submete nada: ele leva o assunto para a IA e volta
// com um questionário sob medida, que é o que a tela `perguntas` consome.
screen {
  resources {
    script(src = "scripts/inicio.luau")
  }

  container(class = tela) {
    scrollable(class = "largo cresce", direction = vertical) {
      container(class = centro) {
        column(class = miolo) {
          row(class = linha) {
            column(class = dupla) {
              text("roadmapia", class = titulo)

              text(
                """
                  Diga o assunto, responda algumas perguntas, receba o material.
                """,
                class = subtitulo,
              )
            }

            button(
              "Retomar rascunho salvo",
              class = btn-sutil,
              on_click = continuar_rascunho,
            )

            // Uma obra que parou no meio (créditos, rede, app fechado): escolhe
            // a pasta dela e gera só o que faltou.
            button(
              "Retomar obra…",
              class = btn-sutil,
              on_click = retomar_obra,
              tooltip = "escolher a pasta de uma obra e gerar só o que faltou",
              tooltip_position = bottom,
            )
          }

          // ── 1. o assunto ─────────────────────────────────────────────────
          column(class = painel-alto) {
            text("1 · SOBRE O QUE?", class = rotulo)

            input(
              class = campo,
              placeholder = "ex.: Rust para quem já programa em Python, com foco em CLIs",
              :value = assunto,
              on_change = assunto_mudou,
              autofocus = true,
            )

            // O que não cabe num título: de onde a pessoa parte, aonde quer
            // chegar, o que já sabe, o que deixar de fora. Vai para a
            // entrevista (que deixa de perguntar o que já está dito aqui), para
            // o esboço e para cada trecho da produção.
            //
            // Sem `on_change`, como as observações de `perguntas`: o motor já
            // espelha o texto do editor no contexto, e um handler que
            // reescrevesse `ctx.detalhes` a cada tecla jogaria o cursor para o
            // fim.
            textarea(
              class = "campo campo-alto",
              placeholder = "opcional — comentários adicionais: o que você já sabe, aonde quer chegar, o que deve ficar de fora, que ferramentas usar…",
              :value = detalhes,
            )

            text(
              """
                Quanto mais contexto aqui, mais afiadas as perguntas de
                refinamento — e o que já estiver dito não vira pergunta.
              """,
              class = ajuda,
            )
          }

          // ── 2. o tipo de artefato ────────────────────────────────────────
          column(class = painel) {
            text("2 · O QUE GERAR?", class = rotulo)

            column(class = bloco) {
              checkbox(
                label = "Roadmap — trilha por fases, com marcos e dependências",
                :checked = tipo_roadmap,
                on_toggle = escolher_tipo:roadmap,
              )

              checkbox(
                label = "Curso — módulos, aulas, exercícios e avaliação",
                :checked = tipo_curso,
                on_toggle = escolher_tipo:curso,
              )

              checkbox(
                label = "Guia — referência prática, direto ao ponto",
                :checked = tipo_guia,
                on_toggle = escolher_tipo:guia,
              )
            }
          }

          // ── 3. exercícios e prova (só para curso) ────────────────────────
          // Um curso sem exercício e sem avaliação é um livro com capa de
          // curso — e é o que o próprio rótulo do tipo promete. O painel só
          // aparece para "Curso": `A.config` zera a avaliação fora dele, então
          // marcar "guia" nunca produz um guia com prova.
          column(class = painel, if = @tipo_curso, equals = true) {
            text("3 · EXERCÍCIOS E PROVA", class = rotulo)

            column(class = bloco) {
              checkbox(
                label = "Lista de exercícios ao fim de cada capítulo",
                :checked = quer_exercicios,
                on_toggle = alternar_exercicios,
              )

              row(class = linha, if = @quer_exercicios, equals = true) {
                input(
                  class = campo-num,
                  placeholder = 10,
                  :value = n_exercicios,
                  on_change = n_exercicios_mudou,
                )

                text("exercícios por capítulo (até 40)", class = "ajuda largo")
              }

              checkbox(
                label = "Prova final da obra",
                :checked = quer_prova,
                on_toggle = alternar_prova,
              )

              row(class = linha, if = @quer_prova, equals = true) {
                input(
                  class = campo-num,
                  placeholder = 40,
                  :value = n_questoes,
                  on_change = n_questoes_mudou,
                )

                text("questões na prova (até 120)", class = "ajuda largo")
              }
            }

            // A conta aparece ANTES de custar, como a amostra da produção.
            text(
              "@aviso_avaliacao",
              class = nota,
              if = @tem_aviso_avaliacao,
              equals = true,
            )

            alert(
              "@alerta_avaliacao",
              variant = warning,
              if = @tem_alerta_avaliacao,
              equals = true,
            )
          }

          // ── 4. o modelo ──────────────────────────────────────────────────
          column(class = painel) {
            row(class = linha) {
              text("4 · MODELO E CHAVE", class = "rotulo largo")

              button(
                "@rotulo_avancado",
                class = btn-sutil,
                on_click = alternar_avancado,
              )
            }

            column(class = bloco, if = @mostrar_avancado) {
              column(class = grupo) {
                text("Modelo (OpenRouter)", class = ajuda)

                select(
                  class = campo,
                  :options = modelos,
                  :value = modelo,
                  on_change = modelo_mudou,
                  placeholder = "escolha um modelo",
                )
              }

              column(class = grupo) {
                text(
                  "Ou um id qualquer do catálogo do OpenRouter",
                  class = ajuda,
                )

                input(
                  class = campo,
                  placeholder = "autor/modelo",
                  :value = modelo,
                  on_change = modelo_mudou,
                )
              }

              // O campo aparece SEMPRE, inclusive com a chave vindo do
              // ambiente: como o `.ini` vence o ambiente, digitar aqui é a
              // forma de trocar de chave sem sair do app. Quem diz de onde a
              // que está valendo veio é a nota logo abaixo.
              column(class = grupo) {
                text(
                  """
                    Chave da API (fica guardada no arquivo de configuração)
                  """,
                  class = ajuda,
                )

                input(
                  class = campo,
                  placeholder = sk-or-v1-...,
                  :value = api_key,
                  on_change = chave_mudou,
                  secure = true,
                )
              }

              text(
                "@nota_chave",
                class = ok,
                if = @tem_nota_chave,
                equals = true,
              )
            }

            text(
              "@resumo_config",
              class = nota,
              if = @mostrar_avancado,
              not_equals = true,
            )
          }

          // ── ação ─────────────────────────────────────────────────────────
          row(class = linha) {
            button(
              "Refinar com perguntas →",
              class = btn-primario,
              on_click = refinar,
              disabled = @ocupado,
            )

            button(
              "Retomar entrevista",
              class = btn,
              navigate_to = perguntas,
              hidden = @sem_perguntas,
            )

            spinner(class = spinner-azul, hidden = @parado)
            text("@status", class = "corpo largo")
          }

          alert("@erro", variant = error, if = @tem_erro, equals = true)
        }
      }
    }
  }
}
