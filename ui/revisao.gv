<!-- Tela 3 — a revisão do plano.
   A IA devolveu um esboço: capítulos e subcapítulos, só títulos e foco. Antes
   de qualquer trecho ser escrito de verdade (e cobrado), dá para corrigir o
   que ela planejou — editar, apagar, reordenar, acrescentar. Só ao confirmar
   é que o plano vira uma fila de produção de verdade, na tela seguinte. -->
<screen>
  <resources>
    <script src="scripts/revisao.luau"></script>
  </resources>

  <container class="tela">
    <column class="coluna cresce">

    <!-- ── cabeçalho ──────────────────────────────────────────────────── -->
    <row class="linha">
      <column class="dupla">
        <text class="titulo-obra">Revise o plano</text>
        <text class="nota">{rev_n_capitulos} capítulos — corrija antes de produzir</text>
      </column>
      <button
        class="btn-sutil"
        text="← respostas"
        navigate_to="perguntas"
      />
    </row>

    <!-- ── sem esboço ainda ───────────────────────────────────────────── -->
    <column class="painel-alto" if="{rev_tem_esboco}" not_equals="true">
      <text class="pergunta">Nada planejado ainda</text>
      <text class="ajuda">Responda a entrevista e clique em Generate.</text>
      <button class="btn-primario" text="Ir para as perguntas" navigate_to="perguntas" />
    </column>

    <column class="secao cresce" if="{rev_tem_esboco}" equals="true">

      <!-- ── a obra ──────────────────────────────────────────────────── -->
      <column class="painel">
        <text class="rotulo">A OBRA</text>
        <input
          class="campo"
          placeholder="título"
          value="rev_titulo"
          on_change="titulo_obra_mudou"
        />
        <textarea
          class="campo campo-resumo"
          placeholder="resumo — o que a pessoa sabe fazer ao terminar"
          value="rev_resumo"
          on_change="resumo_obra_mudou"
        />
        <input
          class="campo"
          placeholder="público — de quem é este material"
          value="rev_publico"
          on_change="publico_obra_mudou"
        />
      </column>

      <!-- ── exercícios e prova (só para curso) ───────────────────────── -->
      <!-- Repetido da tela inicial de propósito: este é o último ponto antes
        de pagar, e o único em que o tamanho real da obra já é conhecido. -->
      <column class="painel" if="{tipo_e_curso}" equals="true">
        <text class="rotulo">EXERCÍCIOS E PROVA</text>
        <text class="nota">{resumo_avaliacao}</text>
        <column class="bloco">
          <checkbox
            label="Lista de exercícios ao fim de cada capítulo"
            checked="quer_exercicios"
            on_toggle="alternar_exercicios"
          />
          <row class="linha" if="{quer_exercicios}" equals="true">
            <input
              class="campo-num"
              placeholder="10"
              value="n_exercicios"
              on_change="n_exercicios_mudou"
            />
            <text class="ajuda largo">exercícios por capítulo (até 40)</text>
          </row>

          <checkbox
            label="Prova final da obra"
            checked="quer_prova"
            on_toggle="alternar_prova"
          />
          <row class="linha" if="{quer_prova}" equals="true">
            <input
              class="campo-num"
              placeholder="40"
              value="n_questoes"
              on_change="n_questoes_mudou"
            />
            <text class="ajuda largo">questões na prova (até 120)</text>
          </row>
        </column>
        <text class="nota" if="{tem_aviso_avaliacao}" equals="true">
          {aviso_avaliacao}
        </text>
        <text class="erro" if="{tem_alerta_avaliacao}" equals="true">
          {alerta_avaliacao}
        </text>
      </column>

      <!-- ── o que a conferência de repetições corrigiu ──────────────── -->
      <!-- A conferência roda sozinha junto com o esboço: o mesmo assunto
        planejado em dois capítulos é um defeito do plano, não uma opinião —
        e um defeito que ninguém clicou para procurar continua lá. O que
        sobra para a tela é discordar, linha a linha. -->
      <column class="painel" if="{aud_tem_achados}" equals="true">
        <text class="rotulo">{aud_rotulo}</text>
        <text class="ajuda">
          O foco de cada trecho abaixo foi reescrito para usar o assunto em vez
          de reensiná-lo. Discordou? Desfaça — ou edite o foco à mão no capítulo.
        </text>
        <column class="lista">
          <row class="faixa linha" for-each="aud_ui" var="a">
            <column class="dupla">
              <text class="corpo">{a.assunto}</text>
              <text class="nota">{a.onde}</text>
              <text class="ajuda">{a.motivo}</text>
            </column>
            <button
              class="btn-sutil"
              text="{a.rotulo}"
              on_click="desfazer_achado:{a.n}"
              disabled="{ocupado}"
            />
          </row>
        </column>
      </column>

      <!-- ── os capítulos ────────────────────────────────────────────── -->
      <scrollable class="largo cresce" direction="vertical">
      <column class="bloco">

        <column class="painel" for-each="rev_capitulos_ui" var="c">
          <row class="linha">
            <text class="contador num">{c.n}</text>
            <column class="dupla">
              <text class="corpo">{c.titulo}</text>
              <text class="nota">{c.resumo}</text>
              <text class="nota">{c.n_subs} subcapítulos</text>
            </column>
            <button class="btn-sutil" text="▲" on_click="mover_cima:{c.n}" />
            <button class="btn-sutil" text="▼" on_click="mover_baixo:{c.n}" />
            <button class="btn-sutil" text="editar" on_click="selecionar_capitulo:{c.n}" />
            <button class="btn-sutil" text="excluir" on_click="excluir_capitulo:{c.n}" />
          </row>

          <!-- painel de edição — só para o capítulo selecionado -->
          <column class="bloco" if="{c.selecionado}" equals="true">
            <input
              class="campo"
              placeholder="título do capítulo"
              value="rev_cap_titulo"
              on_change="titulo_cap_mudou"
            />
            <textarea
              class="campo campo-resumo"
              placeholder="resumo — o papel dele na obra"
              value="rev_cap_resumo"
              on_change="resumo_cap_mudou"
            />

            <text class="rotulo">SUBCAPÍTULOS</text>
            <column class="lista">
              <row class="linha" for-each="rev_subs_ui" var="s">
                <input
                  class="campo"
                  placeholder="título do subcapítulo"
                  value="sub_titulo_{s.n}"
                  on_change="titulo_sub_mudou:{s.n}"
                />
                <input
                  class="campo"
                  placeholder="foco — o que este trecho deve ensinar"
                  value="sub_foco_{s.n}"
                  on_change="foco_sub_mudou:{s.n}"
                />
                <button class="btn-sutil" text="remover" on_click="excluir_sub:{s.n}" />
              </row>
            </column>

            <row class="linha">
              <button class="btn-sutil" text="+ adicionar subcapítulo" on_click="adicionar_sub" />
              <text class="largo" content="" />
              <button class="btn-sutil" text="fechar edição" on_click="fechar_edicao" />
            </row>
          </column>
        </column>

        <button class="btn largo" text="+ adicionar capítulo" on_click="adicionar_capitulo" />

      </column>
      </scrollable>

      <container class="faixa" if="{tem_erro}" equals="true">
        <text class="erro">{erro}</text>
      </container>

      <!-- ── ações ─────────────────────────────────────────────────────── -->
      <row class="painel linha">
        <button
          class="btn"
          text="← gerar de novo"
          on_click="gerar_de_novo"
          disabled="{ocupado}"
        />
        <spinner class="spinner" hidden="{parado}" />
        <text class="corpo largo">{status}</text>
        <button
          class="btn-gerar"
          text="Confirmar plano e produzir →"
          on_click="confirmar"
          disabled="{ocupado}"
        />
      </row>

    </column>

    </column>
  </container>
</screen>
